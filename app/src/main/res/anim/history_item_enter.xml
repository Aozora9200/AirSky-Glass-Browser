<?xml version="1.0" encoding="utf-8"?>
<!-- 履歴の行が上から順に、少し下から浮かび上がって現れる -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="360">
    <translate
        android:fromYDelta="24dp"
        android:toYDelta="0" />
    <alpha
        android:fromAlpha="0"
        android:toAlpha="1" />
    <scale
        android:fromXScale="0.96"
        android:fromYScale="0.96"
        android:pivotX="50%"
        android:pivotY="0%"
        android:toXScale="1"
        android:toYScale="1" />
</set>
