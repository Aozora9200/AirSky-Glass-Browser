<?xml version="1.0" encoding="utf-8"?>
<!-- 履歴 1 件。カードの角の丸みはまとまりの中の位置に合わせてコードで付ける -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">

    <LinearLayout
        android:id="@+id/hrCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="72dp"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="6dp"
        android:paddingBottom="10dp">

        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp">

            <FrameLayout
                android:id="@+id/hrIconBg"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:clipToOutline="true">

                <TextView
                    android:id="@+id/hrLetter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/hrIcon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:visibility="gone" />
            </FrameLayout>

            <!-- 選択中のしるし -->
            <FrameLayout
                android:id="@+id/hrCheck"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_nt_check"
                    app:tint="?attr/colorOnPrimary" />
            </FrameLayout>
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/hrTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="?attr/colorOnSurface"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/hrSub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="13sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/hrMore"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/ripple_circle_small"
            android:contentDescription="@string/i18n_e334d8acd3"
            android:src="@drawable/ic_pm_more"
            app:tint="?attr/colorOnSurfaceVariant" />
    </LinearLayout>
</FrameLayout>
