<?xml version="1.0" encoding="utf-8"?>
<!-- サードパーティ Cookie の例外にサイトを追加するダイアログ -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="28dp"
    android:paddingTop="28dp"
    android:paddingEnd="20dp"
    android:paddingBottom="20dp">
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:text="@string/i18n_7e2fb1a43e"
        android:textColor="?attr/colorOnSurface"
        android:textSize="24sp" />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="8dp"
        android:lineSpacingMultiplier="1.2"
        android:text="@string/i18n_8f2b96bb28"
        android:textColor="?attr/colorOnSurface"
        android:textSize="16sp" />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/i18n_89398dfd0b"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="14sp" />
    <EditText
        android:id="@+id/ce_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:hint="@string/i18n_dcecd2726e"
        android:imeOptions="actionDone"
        android:importantForAutofill="no"
        android:inputType="textUri"
        android:singleLine="true"
        android:textSize="18sp" />
    <TextView
        android:id="@+id/ce_error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/i18n_91c479c17e"
        android:textColor="?attr/colorError"
        android:textSize="12sp"
        android:visibility="invisible" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="end|center_vertical"
        android:orientation="horizontal">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/ce_cancel"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="@string/i18n_6ef3498296"
            android:textSize="16sp" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/ce_add"
            style="@style/Widget.Material3.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:enabled="false"
            android:text="@string/i18n_7dc3a57449"
            android:textSize="16sp" />
    </LinearLayout>
</LinearLayout>
