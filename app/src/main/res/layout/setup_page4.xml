<?xml version="1.0" encoding="utf-8"?>
<!-- セットアップ 5: 既定のブラウザ -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout style="@style/Aozora.Setup.Page">

        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/setup_lottie"
            style="@style/Aozora.Setup.Illustration"
            app:lottie_autoPlay="false"
            app:lottie_loop="true"
            app:lottie_rawRes="@raw/lottie_setup_browser" />

        <TextView
            style="@style/Aozora.Setup.Headline"
            android:text="@string/i18n_e83c98cb0a" />

        <TextView
            style="@style/Aozora.Setup.Body"
            android:text="@string/i18n_19ff2e4705" />

        <androidx.cardview.widget.CardView
            style="@style/Aozora.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="20dp">

                <FrameLayout
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_icon_circle">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@mipmap/aozora" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="AirSky Browser"
                        android:textColor="@color/setup_on_card"
                        android:textSize="16sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/i18n_b1c3a51d9a"
                        android:textColor="@color/setup_on_card_variant"
                        android:textSize="14sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/setup_default"
                    style="@style/Aozora.Button.Tonal"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:minHeight="48dp"
                    android:text="@string/i18n_a160b00775" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <TextView
            style="@style/Aozora.Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/i18n_121c5e57e6" />
    </LinearLayout>
</ScrollView>
