<?xml version="1.0" encoding="utf-8"?>
<!--
  リンクの長押しメニュー。
  上: ファビコン・サイト名・URL / 下: 新しいタブで開く などの行(コードで並べる)
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/lm_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="12dp">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:alpha="0.6"
        android:background="@drawable/bg_page_menu_handle"
        android:tag="sheet_handle" />

    <LinearLayout
        android:id="@+id/lm_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="76dp"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="8dp"
        android:paddingEnd="20dp"
        android:paddingBottom="8dp">

        <FrameLayout
            android:id="@+id/lm_icon_bg"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_menu_tile_icon"
            android:backgroundTint="?attr/colorSurfaceContainerHighest">
            <ImageView
                android:id="@+id/lm_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_si_globe" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/lm_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="?attr/colorOnSurface"
                android:textSize="17sp" />
            <TextView
                android:id="@+id/lm_url"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="middle"
                android:singleLine="true"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:id="@+id/lm_rows"
            style="@style/PageMenuGroup"
            android:layout_marginStart="12dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="12dp" />
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
