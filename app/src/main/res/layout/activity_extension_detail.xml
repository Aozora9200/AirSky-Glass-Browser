<?xml version="1.0" encoding="utf-8"?>
<!--
  拡張機能 1 つの画面(Pixel の設定のアプリ情報風)。
  大きなアイコンと名前 / 有効・シークレット / 設定・詳細・権限・ストア / 削除・報告
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:fitsSystemWindows="true">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/edScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="64dp"
        android:clipToPadding="false"
        android:paddingBottom="32dp">

        <LinearLayout
            android:id="@+id/edContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <!-- 大きなアイコンと名前 -->
            <LinearLayout
                android:id="@+id/edHero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="12dp"
                android:paddingBottom="8dp">

                <FrameLayout
                    android:id="@+id/edIconTile"
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:background="@drawable/bg_ext_hero_tile">

                    <ImageView
                        android:id="@+id/edHeroIcon"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no" />
                </FrameLayout>

                <TextView
                    android:id="@+id/edName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="28sp" />

                <TextView
                    android:id="@+id/edAuthor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="14sp" />

                <!-- 状態の札(バージョン・評価・おすすめ) -->
                <LinearLayout
                    android:id="@+id/edChips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center"
                    android:orientation="horizontal" />
            </LinearLayout>

            <TextView
                android:id="@+id/edWarning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_ext_warning"
                android:drawableStart="@drawable/ic_si_warning"
                android:drawablePadding="12dp"
                android:drawableTint="?attr/colorOnErrorContainer"
                android:padding="16dp"
                android:textColor="?attr/colorOnErrorContainer"
                android:textSize="14sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/edToggles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical" />

            <LinearLayout
                android:id="@+id/edLinks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/edRemove"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="@string/i18n_c6577c2e90"
                    android:textColor="?attr/colorError"
                    android:textSize="16sp"
                    app:cornerRadius="28dp"
                    app:icon="@drawable/ic_si_delete"
                    app:iconGravity="textStart"
                    app:iconTint="?attr/colorError"
                    app:strokeColor="?attr/colorError" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/edReport"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:text="@string/i18n_e5ab98fd66"
                    android:textSize="16sp"
                    app:cornerRadius="28dp"
                    app:icon="@drawable/ic_ext_flag"
                    app:iconGravity="textStart" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/edHeader"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="?attr/colorSurface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <ImageButton
            android:id="@+id/edBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/ripple_circle_small"
            android:contentDescription="@string/i18n_4a622f127b"
            android:src="@drawable/ic_si_back"
            app:tint="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/edSmallTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:alpha="0"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="?attr/colorOnSurface"
            android:textSize="22sp" />
    </LinearLayout>
</FrameLayout>
