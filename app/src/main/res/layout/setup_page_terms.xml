<?xml version="1.0" encoding="utf-8"?>
<!-- セットアップ 2: 利用規約(「同意する」で次へ。同意しないと先へ進めない) -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout style="@style/Aozora.Setup.Page">

        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/setup_lottie"
            style="@style/Aozora.Setup.Illustration"
            app:lottie_autoPlay="false"
            app:lottie_loop="false"
            app:lottie_rawRes="@raw/lottie_setup_terms" />

        <TextView
            style="@style/Aozora.Setup.Headline"
            android:text="@string/i18n_940876a28f" />

        <TextView
            style="@style/Aozora.Setup.Body"
            android:text="@string/i18n_edd67af5de" />

        <androidx.cardview.widget.CardView
            style="@style/Aozora.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp">

            <FrameLayout
                android:id="@+id/setup_terms_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </androidx.cardview.widget.CardView>

        <TextView
            style="@style/Aozora.Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/i18n_c90e2ef499" />
    </LinearLayout>
</ScrollView>
