<?xml version="1.0" encoding="utf-8"?>
<!-- 「プログレスバーとは」(Pixel のセットアップ風。背景の写真は元のまま) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/setupback" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="true"
        android:orientation="vertical">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout style="@style/Aozora.Setup.Page">

                <com.airbnb.lottie.LottieAnimationView
                    style="@style/Aozora.Setup.Illustration"
                    app:lottie_autoPlay="true"
                    app:lottie_loop="true"
                    app:lottie_rawRes="@raw/lottie_loading" />

                <TextView
                    style="@style/Aozora.Setup.Headline"
                    android:shadowColor="#99000000"
                    android:shadowRadius="8"
                    android:text="@string/i18n_2d8c2abb8f" />

                <TextView
                    style="@style/Aozora.Setup.Body"
                    android:shadowColor="#99000000"
                    android:shadowRadius="6"
                    android:text="@string/i18n_d34227740f" />

                <androidx.cardview.widget.CardView
                    style="@style/Aozora.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/i18n_102afe791f"
                            android:textColor="@color/setup_on_card"
                            android:textSize="16sp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/i18n_9f004d30af"
                            android:textColor="@color/setup_on_card_variant"
                            android:textSize="14sp" />

                        <androidx.cardview.widget.CardView
                            style="@style/Aozora.Card.Inner"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp">

                            <com.airbnb.lottie.LottieAnimationView
                                android:layout_width="match_parent"
                                android:layout_height="56dp"
                                android:contentDescription="@string/i18n_f6484c39a2"
                                android:paddingLeft="12dp"
                                android:paddingRight="12dp"
                                app:lottie_autoPlay="true"
                                app:lottie_loop="true"
                                app:lottie_rawRes="@raw/lottie_progress_smooth" />
                        </androidx.cardview.widget.CardView>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="24dp"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/i18n_935cf9b3c8"
                            android:textColor="@color/setup_on_card"
                            android:textSize="16sp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/i18n_8fcf17682a"
                            android:textColor="@color/setup_on_card_variant"
                            android:textSize="14sp" />

                        <androidx.cardview.widget.CardView
                            style="@style/Aozora.Card.Inner"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp">

                            <com.airbnb.lottie.LottieAnimationView
                                android:layout_width="match_parent"
                                android:layout_height="56dp"
                                android:contentDescription="@string/i18n_20c3b06003"
                                android:paddingLeft="12dp"
                                android:paddingRight="12dp"
                                app:lottie_autoPlay="true"
                                app:lottie_loop="true"
                                app:lottie_rawRes="@raw/lottie_progress_step" />
                        </androidx.cardview.widget.CardView>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <TextView
                    style="@style/Aozora.Text.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:shadowColor="#99000000"
                    android:shadowRadius="6"
                    android:text="@string/i18n_076862b049" />
            </LinearLayout>
        </ScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:paddingLeft="24dp"
            android:paddingTop="12dp"
            android:paddingRight="24dp"
            android:paddingBottom="20dp">

            <Button
                android:id="@+id/help_close"
                style="@style/Aozora.Button.Filled"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:minWidth="112dp"
                android:paddingLeft="28dp"
                android:paddingRight="28dp"
                android:text="@string/i18n_5dce862819" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
