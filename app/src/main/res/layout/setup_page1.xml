<?xml version="1.0" encoding="utf-8"?>
<!-- セットアップ 1: ようこそ(Pixel の「こんにちは」の画面のように中央に大きく) -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp">

        <!-- Lottie の波紋の中央にアプリのアイコン -->
        <FrameLayout
            android:layout_width="264dp"
            android:layout_height="264dp">

            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/setup_lottie"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                app:lottie_autoPlay="true"
                app:lottie_loop="true"
                app:lottie_rawRes="@raw/lottie_ripple" />

            <ImageView
                android:id="@+id/setup_welcome_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:adjustViewBounds="true"
                android:contentDescription="@null"
                android:maxHeight="132dp"
                android:maxWidth="152dp"
                android:src="@mipmap/aozora1" />
        </FrameLayout>

        <TextView
            android:id="@+id/setup_welcome_title"
            style="@style/Aozora.Setup.Headline"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="@string/i18n_17dfdf8433"
            android:textSize="44sp" />

        <TextView
            style="@style/Aozora.Setup.Body"
            android:gravity="center"
            android:text="@string/i18n_b3dd9ec898" />

        <TextView
            android:id="@+id/setup_version"
            style="@style/Aozora.Text.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:alpha="0.8"
            android:text="" />
    </LinearLayout>
</ScrollView>
