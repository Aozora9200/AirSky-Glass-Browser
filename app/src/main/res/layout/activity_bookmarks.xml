<?xml version="1.0" encoding="utf-8"?>
<!--
  ブックマーク。一番上は「ブックマーク」「その他のブックマーク」「リーディングリスト」の 3 つのフォルダ。
  見出し: 戻る・今のフォルダ・並べ替え・新しいフォルダ・閉じる / 検索欄 / 一覧
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bmRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <ImageButton
            android:id="@+id/bmBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/ripple_circle_small"
            android:contentDescription="@string/i18n_4a622f127b"
            android:src="@drawable/ic_si_back"
            app:tint="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/bmTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="?attr/colorOnSurface"
            android:textSize="22sp" />

        <ImageButton
            android:id="@+id/bmSort"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/ripple_circle_small"
            android:contentDescription="@string/i18n_904e8027c8"
            android:src="@drawable/ic_bm_sort"
            app:tint="?attr/colorOnSurfaceVariant" />

        <ImageButton
            android:id="@+id/bmNewFolder"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/ripple_circle_small"
            android:contentDescription="@string/i18n_20c86957b3"
            android:src="@drawable/ic_bm_new_folder"
            app:tint="?attr/colorOnSurfaceVariant" />

        <ImageButton
            android:id="@+id/bmClose"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/ripple_circle_small"
            android:contentDescription="@string/i18n_5dce862819"
            android:src="@drawable/ic_ts_close"
            app:tint="?attr/colorOnSurfaceVariant" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/bg_find_bar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="4dp">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_ts_search"
            app:tint="?attr/colorOnSurfaceVariant" />

        <EditText
            android:id="@+id/bmSearch"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@null"
            android:hint="@string/i18n_3aa80a87c1"
            android:imeOptions="actionSearch|flagNoExtractUi"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLines="1"
            android:paddingStart="12dp"
            android:paddingEnd="8dp"
            android:textColor="?attr/colorOnSurface"
            android:textColorHint="?attr/colorOnSurfaceVariant"
            android:textSize="16sp" />

        <ImageButton
            android:id="@+id/bmSearchClear"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/ripple_circle_small"
            android:contentDescription="@string/i18n_2b4c324620"
            android:src="@drawable/ic_ts_close"
            android:visibility="gone"
            app:tint="?attr/colorOnSurfaceVariant" />
    </LinearLayout>

    <!-- 今いるフォルダまでの道筋(押すとそのフォルダへ戻る) -->
    <HorizontalScrollView
        android:id="@+id/bmPathScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/bmPath"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:gravity="center_vertical"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/bmList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="4dp"
            android:paddingBottom="24dp" />

        <LinearLayout
            android:id="@+id/bmEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:visibility="gone">

            <FrameLayout
                android:id="@+id/bmEmptyArt"
                android:layout_width="150dp"
                android:layout_height="120dp">

                <!-- 後ろの 2 枚の角丸の板と、前のアイコンの板を重ねた絵 -->
                <View
                    android:id="@+id/bmEmptyBack1"
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:layout_gravity="start|center_vertical"
                    android:background="@drawable/bg_bm_tile"
                    android:rotation="-12" />

                <View
                    android:id="@+id/bmEmptyBack2"
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:layout_gravity="end|center_vertical"
                    android:background="@drawable/bg_bm_tile"
                    android:rotation="12" />

                <FrameLayout
                    android:id="@+id/bmEmptyFront"
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_bm_tile">

                    <ImageView
                        android:id="@+id/bmEmptyIcon"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no" />
                </FrameLayout>
            </FrameLayout>

            <TextView
                android:id="@+id/bmEmptyTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:gravity="center"
                android:textColor="?attr/colorOnSurface"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/bmEmptyBody"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:lineSpacingMultiplier="1.2"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="15sp" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
