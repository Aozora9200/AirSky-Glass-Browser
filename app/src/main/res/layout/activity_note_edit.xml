<?xml version="1.0" encoding="utf-8"?>
<!-- メモの編集(Google Keep 風)。背景はメモの色になる -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/neRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- 上のバー -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp">

        <ImageButton
            android:id="@+id/neBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/tool_back"
            android:src="@drawable/ic_si_back" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/nePreview"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/i18n_858a38d441"
            android:src="@drawable/ic_nt_preview" />

        <ImageButton
            android:id="@+id/nePin"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/i18n_1ef8fd2113"
            android:src="@drawable/ic_nt_pin_outline" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/neScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/neContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- 写真・動画・手書き -->
            <LinearLayout
                android:id="@+id/neMedia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="12dp" />

            <EditText
                android:id="@+id/neTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:hint="@string/i18n_77d0d6a051"
                android:inputType="textCapSentences|textMultiLine"
                android:paddingHorizontal="20dp"
                android:paddingTop="12dp"
                android:paddingBottom="8dp"
                android:textColor="?attr/colorOnSurface"
                android:textColorHint="?attr/colorOnSurfaceVariant"
                android:textSize="22sp" />

            <EditText
                android:id="@+id/neBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:gravity="top"
                android:hint="@string/i18n_df828aef1c"
                android:inputType="textCapSentences|textMultiLine"
                android:lineSpacingMultiplier="1.2"
                android:minHeight="120dp"
                android:paddingHorizontal="20dp"
                android:paddingVertical="8dp"
                android:textColor="?attr/colorOnSurface"
                android:textColorHint="?attr/colorOnSurfaceVariant"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/neRendered"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingMultiplier="1.2"
                android:minHeight="120dp"
                android:paddingHorizontal="20dp"
                android:paddingVertical="8dp"
                android:textColor="?attr/colorOnSurface"
                android:textIsSelectable="true"
                android:textSize="16sp"
                android:visibility="gone" />

            <!-- チェックリスト -->
            <LinearLayout
                android:id="@+id/neChecklist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/neItems"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:animateLayoutChanges="true"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/neAddItem"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackground"
                    android:drawableStart="@drawable/ic_ts_add"
                    android:drawablePadding="16dp"
                    android:drawableTint="?attr/colorOnSurfaceVariant"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="20dp"
                    android:text="@string/i18n_cc96a4a98c"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/neCheckedHeader"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackground"
                    android:drawableStart="@drawable/ic_arrow_drop_down"
                    android:drawablePadding="12dp"
                    android:drawableTint="?attr/colorOnSurfaceVariant"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="14sp" />

                <LinearLayout
                    android:id="@+id/neCheckedItems"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:animateLayoutChanges="true"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- 録音 -->
            <LinearLayout
                android:id="@+id/neAudio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="12dp" />

            <!-- URL のプレビュー -->
            <LinearLayout
                android:id="@+id/neLinks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="12dp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- マークダウンの書式ボタン(本文を編集中だけ出す) -->
    <HorizontalScrollView
        android:id="@+id/neFormatBar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/neFormatButtons"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp" />
    </HorizontalScrollView>

    <!-- 下のバー -->
    <LinearLayout
        android:id="@+id/neBottom"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp">

        <ImageButton
            android:id="@+id/neAdd"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/i18n_7dc3a57449"
            android:src="@drawable/ic_nt_add_box" />

        <ImageButton
            android:id="@+id/neColor"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/i18n_2f97db95d7"
            android:src="@drawable/ic_nt_palette" />

        <ImageButton
            android:id="@+id/neMarkdownBtn"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/i18n_e78ad4a459"
            android:src="@drawable/ic_nt_markdown" />

        <TextView
            android:id="@+id/neEdited"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="12sp" />

        <ImageButton
            android:id="@+id/neMore"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/i18n_02e915b7b2"
            android:src="@drawable/ic_nt_more" />
    </LinearLayout>
</LinearLayout>
