<?xml version="1.0" encoding="utf-8"?>
<!--
  ページ内検索。画面の上に浮かぶ角丸のカード。
  1 段目: 検索アイコン・入力欄・件数の札・前へ/次へ・閉じる
  2 段目: 何件中どこにいるかのトラック(一致の目盛りと、今の位置の粒)
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/findInPageBar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:id="@+id/findCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_find_bar"
        android:clickable="true"
        android:focusable="false"
        android:elevation="6dp"
        android:orientation="vertical"
        android:paddingStart="6dp"
        android:paddingTop="4dp"
        android:paddingEnd="6dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/findIcon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:importantForAccessibility="no"
                android:padding="8dp"
                android:src="@drawable/ic_pm_find"
                android:tint="?attr/colorPrimary" />

            <EditText
                android:id="@+id/etFindQuery"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/i18n_8e5871e71e"
                android:imeOptions="actionSearch|flagNoExtractUi"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLines="1"
                android:paddingStart="4dp"
                android:paddingEnd="8dp"
                android:textColor="?attr/colorOnSurface"
                android:textColorHint="?attr/colorOnSurfaceVariant"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/tvFindCount"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_find_count"
                android:fontFeatureSettings="tnum"
                android:gravity="center"
                android:minWidth="52dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="0 / 0"
                android:textColor="?attr/colorOnSecondaryContainer"
                android:textSize="13sp"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/btnFindPrev"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/ripple_circle_small"
                android:contentDescription="@string/i18n_630a02b200"
                android:src="@drawable/ic_find_up" />

            <ImageButton
                android:id="@+id/btnFindNext"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/ripple_circle_small"
                android:contentDescription="@string/i18n_ebf3d62729"
                android:src="@drawable/ic_find_down" />

            <ImageButton
                android:id="@+id/btnFindClose"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/ripple_circle_small"
                android:contentDescription="@string/i18n_045dc6067d"
                android:src="@drawable/ic_ts_close"
                android:tint="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

        <com.airsky.browser.FindMatchTrackView
            android:id="@+id/findTrack"
            android:layout_width="match_parent"
            android:layout_height="12dp"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp" />
    </LinearLayout>
</FrameLayout>
