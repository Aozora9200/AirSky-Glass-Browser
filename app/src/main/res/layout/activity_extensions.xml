<?xml version="1.0" encoding="utf-8"?>
<!--
  拡張機能の管理(Pixel の設定風)。
  上: 戻る・(スクロールすると現れる)小さな見出し・メニュー
  中: 大きな見出し / 有効 / 無効 / おすすめ のカード
  下: 「拡張機能を探す」のボタン(スクロールすると縮む)
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:fitsSystemWindows="true">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/exScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="64dp"
        android:clipToPadding="false"
        android:paddingBottom="112dp">

        <LinearLayout
            android:id="@+id/exContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <TextView
                android:id="@+id/exBigTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:paddingStart="8dp"
                android:text="@string/i18n_5bbfc433b5"
                android:textColor="?attr/colorOnSurface"
                android:textSize="40sp" />

            <!-- [Firefox 拡張機能] [Coara Browser 拡張機能] の切り替え(文字はコードで入れる) -->
            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/exKind"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:checkedButton="@+id/exKindFirefox"
                app:selectionRequired="true"
                app:singleSelection="true">

                <Button
                    android:id="@+id/exKindFirefox"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:maxLines="2"
                    android:ellipsize="end" />

                <Button
                    android:id="@+id/exKindCoara"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:maxLines="2"
                    android:ellipsize="end" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <TextView
                android:id="@+id/exBigSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:paddingStart="8dp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="15sp" />

            <!-- 有効・無効・おすすめ(コードで作る) -->
            <LinearLayout
                android:id="@+id/exSections"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/exNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:drawableStart="@drawable/ic_si_info"
                android:drawablePadding="12dp"
                android:drawableTint="?attr/colorOnSurfaceVariant"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="@string/i18n_d2cd10cd30"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="13sp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- 見出し(スクロールすると下に影が出て、小さな見出しが現れる) -->
    <LinearLayout
        android:id="@+id/exHeader"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="?attr/colorSurface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <ImageButton
            android:id="@+id/exBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/ripple_circle_small"
            android:contentDescription="@string/i18n_4a622f127b"
            android:src="@drawable/ic_si_back"
            app:tint="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/exSmallTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:alpha="0"
            android:text="@string/i18n_5bbfc433b5"
            android:textColor="?attr/colorOnSurface"
            android:textSize="22sp" />

        <ImageButton
            android:id="@+id/exMenu"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/ripple_circle_small"
            android:contentDescription="@string/i18n_e334d8acd3"
            android:src="@drawable/ic_ts_more"
            app:tint="?attr/colorOnSurfaceVariant" />
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/exFind"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="20dp"
        android:text="@string/i18n_df28873ab1"
        app:icon="@drawable/ic_ext_store" />
</FrameLayout>
