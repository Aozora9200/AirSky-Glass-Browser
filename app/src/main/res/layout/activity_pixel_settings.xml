<?xml version="1.0" encoding="utf-8"?>
<!--
  Pixel 風の設定画面の共通レイアウト(PixelSettingsActivity)。
  上: 戻る・小さな見出し(大きな見出しが隠れると出る) / 大きな見出し / 検索欄(トップのみ) / 項目
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ps_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ps_page_bg"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/ps_bar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">
        <ImageButton
            android:id="@+id/ps_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/i18n_4a622f127b"
            android:src="@drawable/ic_si_back" />
        <TextView
            android:id="@+id/ps_bar_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:alpha="0"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="?attr/colorOnSurface"
            android:textSize="22sp" />
        <ImageButton
            android:id="@+id/ps_action"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:visibility="gone" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/ps_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:animateLayoutChanges="false"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="40dp">

            <!-- 大きな見出し(スクロールすると上のバーに移る) -->
            <TextView
                android:id="@+id/ps_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"
                android:paddingHorizontal="12dp"
                android:textColor="?attr/colorOnSurface"
                android:textSize="36sp" />

            <!-- 設定項目を検索(トップの設定だけ) -->
            <LinearLayout
                android:id="@+id/ps_search_box"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_ps_search"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="20dp"
                android:paddingEnd="8dp"
                android:visibility="gone">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_ps_search" />
                <EditText
                    android:id="@+id/ps_search"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="@string/i18n_1fd8563fcf"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:singleLine="true"
                    android:textColor="?attr/colorOnSurface"
                    android:textColorHint="?attr/colorOnSurfaceVariant"
                    android:textSize="17sp" />
                <ImageButton
                    android:id="@+id/ps_search_clear"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/i18n_deba64e8e6"
                    android:src="@drawable/ic_si_close"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/ps_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
