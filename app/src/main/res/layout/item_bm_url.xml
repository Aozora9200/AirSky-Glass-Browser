<?xml version="1.0" encoding="utf-8"?>
<!-- ブックマーク 1 件の行。左にページの画像(無ければ頭文字)のタイル -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="80dp"
    android:orientation="horizontal"
    android:paddingStart="20dp"
    android:paddingTop="8dp"
    android:paddingEnd="8dp"
    android:paddingBottom="8dp">

    <FrameLayout
        android:layout_width="56dp"
        android:layout_height="56dp">

        <FrameLayout
            android:id="@+id/bmTile"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_bm_tile"
            android:clipToOutline="true">

            <TextView
                android:id="@+id/bmLetter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:textSize="22sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/bmThumb"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                android:visibility="gone" />
        </FrameLayout>

        <View
            android:id="@+id/bmUnread"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="-3dp"
            android:layout_marginEnd="-3dp"
            android:background="@drawable/bg_bm_unread"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/bmTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="?attr/colorOnSurface"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/bmSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="13sp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/bmMore"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/ripple_circle_small"
        android:contentDescription="@string/i18n_e334d8acd3"
        android:src="@drawable/ic_pm_more"
        app:tint="?attr/colorOnSurfaceVariant" />
</LinearLayout>
