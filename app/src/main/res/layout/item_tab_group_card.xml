<?xml version="1.0" encoding="utf-8"?>
<!-- タブ一覧のタブグループのカード。色の丸・名前・メニューと、タブの 2 × 2 のサムネイル -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="6dp">

    <LinearLayout
        android:id="@+id/tgCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp">

            <View
                android:id="@+id/tgDot"
                android:layout_width="16dp"
                android:layout_height="16dp" />

            <TextView
                android:id="@+id/tgTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:ellipsize="none"
                android:fadingEdgeLength="28dp"
                android:requiresFadingEdge="horizontal"
                android:scrollHorizontally="true"
                android:singleLine="true"
                android:textSize="16sp" />

            <ImageButton
                android:id="@+id/tgMenu"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/i18n_238d7e9e6f"
                android:scaleType="center"
                android:src="@drawable/ic_ts_more" />
        </LinearLayout>

        <com.airsky.browser.TabGroupMosaicView
            android:id="@+id/tgMosaic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>
</FrameLayout>
