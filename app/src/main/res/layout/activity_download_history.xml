<?xml version="1.0" encoding="utf-8"?>
<!--
  ダウンロード一覧(Aozora 独自のデザイン)。
  上: 端末の容量の輪とファイル数のカード / 種類で絞り込むチップ / 日付ごとの、つながったカードの一覧
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/dlRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="64dp">

        <!-- 通常の見出し -->
        <LinearLayout
            android:id="@+id/dlTitleBar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="12dp">

            <ImageButton
                android:id="@+id/dlClose"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/i18n_5dce862819"
                android:src="@drawable/ic_si_back"
                app:tint="?attr/colorOnSurface" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:singleLine="true"
                android:text="@string/i18n_f81fd2e4c5"
                android:textColor="?attr/colorOnSurface"
                android:textSize="22sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/dlSearch"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_dl_action"
                android:contentDescription="@string/i18n_5ab5c66df3"
                android:foreground="@drawable/ripple_circle_small"
                android:src="@drawable/ic_ts_search"
                app:tint="?attr/colorOnSecondaryContainer" />

            <ImageButton
                android:id="@+id/dlSettings"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_dl_action"
                android:contentDescription="@string/i18n_fb646e2fe9"
                android:foreground="@drawable/ripple_circle_small"
                android:src="@drawable/ic_menu_settings"
                app:tint="?attr/colorOnSecondaryContainer" />
        </LinearLayout>

        <!-- 検索中の見出し(丸い検索欄) -->
        <LinearLayout
            android:id="@+id/dlSearchBar"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_find_bar"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:visibility="gone">

            <ImageButton
                android:id="@+id/dlSearchBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/ripple_circle_small"
                android:contentDescription="@string/i18n_769cbe6cac"
                android:src="@drawable/ic_si_back"
                app:tint="?attr/colorOnSurface" />

            <EditText
                android:id="@+id/dlSearchField"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/i18n_ce75933eab"
                android:imeOptions="actionSearch|flagNoExtractUi"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLines="1"
                android:paddingStart="4dp"
                android:textColor="?attr/colorOnSurface"
                android:textColorHint="?attr/colorOnSurfaceVariant"
                android:textSize="17sp" />

            <ImageButton
                android:id="@+id/dlSearchClear"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/ripple_circle_small"
                android:contentDescription="@string/i18n_2b4c324620"
                android:src="@drawable/ic_ts_close"
                android:visibility="gone"
                app:tint="?attr/colorOnSurfaceVariant" />
        </LinearLayout>
    </FrameLayout>

    <!-- 容量とファイル数のカード -->
    <LinearLayout
        android:id="@+id/dlHero"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_dl_hero"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="18dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:baselineAligned="true"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/dlCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFeatureSettings="tnum"
                    android:text="0"
                    android:textColor="?attr/colorOnPrimaryContainer"
                    android:textSize="40sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/i18n_1abe2ef165"
                    android:textColor="?attr/colorOnPrimaryContainer"
                    android:textSize="16sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/dlStorage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="?attr/colorOnPrimaryContainer"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/dlDevice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:alpha="0.75"
                android:textColor="?attr/colorOnPrimaryContainer"
                android:textSize="13sp" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:layout_marginStart="12dp">

            <com.airsky.browser.StorageRingView
                android:id="@+id/dlRing"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <TextView
                android:id="@+id/dlRingText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFeatureSettings="tnum"
                android:textColor="?attr/colorOnPrimaryContainer"
                android:textSize="15sp"
                android:textStyle="bold" />
        </FrameLayout>
    </LinearLayout>

    <HorizontalScrollView
        android:id="@+id/dlChipScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="4dp"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/dlChips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:chipSpacingHorizontal="8dp"
            app:selectionRequired="true"
            app:singleLine="true"
            app:singleSelection="true" />
    </HorizontalScrollView>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="24dp" />

        <LinearLayout
            android:id="@+id/dlEmpty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:background="@drawable/bg_dl_empty">

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_msg_download"
                    app:tint="?attr/colorOnSecondaryContainer" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvEmpty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/i18n_8d3355dac6"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="15sp" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
