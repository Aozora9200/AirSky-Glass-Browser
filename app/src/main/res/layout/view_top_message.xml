<?xml version="1.0" encoding="utf-8"?>
<!-- 画面上部から降りてくる通知(Chrome の「ダウンロードしています」「ページが翻訳されました」風) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:background="@drawable/bg_top_message"
    android:clickable="true"
    android:elevation="6dp"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="72dp"
    android:orientation="horizontal"
    android:paddingStart="20dp"
    android:paddingTop="12dp"
    android:paddingEnd="8dp"
    android:paddingBottom="12dp">

    <FrameLayout
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginEnd="16dp">

        <ImageView
            android:id="@+id/topMessageIcon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no" />

        <!-- アニメーションするアイコン(ダウンロード中の矢印など) -->
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/topMessageAnimation"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/topMessageTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:ellipsize="end"
            android:textColor="?attr/colorOnSurface"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/topMessageSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="2"
            android:ellipsize="end"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/topMessageSecondary"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:scaleType="center"
        android:visibility="gone" />

    <View
        android:id="@+id/topMessageDivider"
        android:layout_width="1dp"
        android:layout_height="32dp"
        android:layout_marginHorizontal="4dp"
        android:background="?attr/colorOutlineVariant"
        android:visibility="gone" />

    <Button
        android:id="@+id/topMessageAction"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="15sp"
        android:visibility="gone" />
</LinearLayout>
