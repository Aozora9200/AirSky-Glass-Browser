<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true">
    <FrameLayout
        android:id="@+id/effectLayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.airsky.browser.BrowserSwipeRefreshLayout
            android:id="@+id/swipeRefreshLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="75dp"
            android:layout_marginBottom="56dp"
            android:layout_weight="1">
        <FrameLayout
            android:id="@+id/contentFrame"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <FrameLayout
                android:id="@+id/webViewContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
            <!-- ネイティブのスタートページ(StartPageView)をタブの上に重ねる場所 -->
            <FrameLayout
                android:id="@+id/startPageContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>
        </com.airsky.browser.BrowserSwipeRefreshLayout>
        <!-- 追加: フルスクリーン用のコンテナ -->
        <FrameLayout
            android:id="@+id/fullscreenContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">
        </FrameLayout>
        <LinearLayout
            android:id="@+id/statusbar"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:clickable="true"
            android:focusable="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:background="?attr/colorSurface">
            <!-- 左: 時計(左右の幅をそろえてサイト名を中央に置く) -->
            <TextClock
                android:layout_width="112dp"
                android:layout_height="wrap_content"
                android:gravity="center_vertical|start"
                android:singleLine="true"
                android:fontFamily="sans-serif-medium"
                android:textSize="12sp"
                android:textColor="?attr/colorOnSurface" />
            <!-- 中央: 読み込み中の表示とサイト名 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="horizontal">
                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/pageloading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:indeterminate="true"
                    app:indicatorSize="11dp"
                    app:indicatorInset="0dp"
                    app:trackThickness="1.5dp"
                    app:trackCornerRadius="1dp" />
                <TextView
                    android:id="@+id/sitename"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:text="AirSky"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textSize="12sp" />
                <!-- 左の読み込み中の表示と同じ幅を右にも空け、サイト名を真ん中に置く -->
                <Space
                    android:layout_width="17dp"
                    android:layout_height="1dp" />
            </LinearLayout>
            <!-- 右: 電波・Wi-Fi・電池 -->
            <LinearLayout
                android:layout_width="112dp"
                android:layout_height="match_parent"
                android:gravity="center_vertical|end"
                android:orientation="horizontal">
                <ImageView
                    android:id="@+id/wifi"
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:layout_marginEnd="5dp"
                    android:scaleType="fitCenter"
                    android:importantForAccessibility="no" />
                <ImageView
                    android:id="@+id/network"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginEnd="6dp"
                    android:scaleType="fitCenter"
                    android:importantForAccessibility="no" />
                <ImageView
                    android:id="@+id/batteryIcon"
                    android:layout_width="22dp"
                    android:layout_height="12dp"
                    android:scaleType="fitCenter"
                    android:visibility="gone"
                    android:importantForAccessibility="no" />
                <TextView
                    android:id="@+id/batteryStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="?attr/colorOnSurface"
                    android:text="--%"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/action_Bar"
            android:layout_marginTop="24dp"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:clickable="true"
            android:focusable="false"
            android:background="?attr/colorSurface"
            android:orientation="horizontal">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <!-- URL バーの枠。左端の中にサイト情報(Favicon)のボタンを入れる -->
                <FrameLayout
                    android:id="@+id/urlBarFrame"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_urlbar">
                    <AutoCompleteTextView
                        android:id="@+id/urlEditText"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@null"
                        android:paddingStart="42dp"
                        android:paddingEnd="16dp"
                        android:textSize="15sp"
                        android:singleLine="true"
                        android:textColor="?attr/colorOnSurface"
                        android:textColorHint="?attr/colorOnSurfaceVariant"
                        android:hint="@string/i18n_a357042f51"
                        android:inputType="textUri"
                        android:selectAllOnFocus="true"
                        android:imeOptions="actionGo"/>
                    <ImageButton
                        android:id="@+id/favicon"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="start|center_vertical"
                        android:layout_marginStart="6dp"
                        android:padding="6dp"
                        android:src="@drawable/transparent_vector"
                        android:contentDescription="@string/i18n_b542647128"
                        android:scaleType="fitCenter"
                        android:background="@drawable/ripple_circle_favicon"/>
                </FrameLayout>
                <!-- ツールバーのショートカット(既定は共有。長押しで変更) -->
                <com.airsky.browser.ShadowImageButton
                    android:id="@+id/action_shortcut"
                    android:layout_width="40dp"
                    android:layout_height="34dp"
                    android:src="@drawable/ic_pm_share"
                    android:tint="?attr/colorOnSurface"
                    android:scaleType="center"
                    android:background="@drawable/ripple_circle_small"
                    android:contentDescription="@string/i18n_8cfef1099a" />
                <com.airsky.browser.ShadowImageButton
                    android:id="@+id/action_bookmark"
                    android:layout_width="50dp"
                    android:layout_height="34dp"
                    android:src="@drawable/ic_pm_more"
                    android:background="@drawable/ripple_circle_small"
                    android:contentDescription="@string/i18n_9013ced74d" />
            </LinearLayout>
        </LinearLayout>
        <!-- Material 3 の波線プログレスバー。読み込みが 90% を超えると波が平らに伸びる -->
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progressBar"
            android:layout_marginTop="67dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="4dp"
            android:max="100"
            android:progress="0"
            app:trackThickness="4dp"
            app:trackCornerRadius="2dp"
            app:waveAmplitude="2dp"
            app:wavelength="20dp"
            app:waveSpeed="20dp"
            app:indicatorTrackGapSize="4dp"
            app:trackStopIndicatorSize="0dp" />
        <!-- <FrameLayout
         android:layout_width="match_parent"
         android:layout_height="match_parent"> -->
        <!-- 下部のアクションバー風ボトムバー
        <LinearLayout
        android:id="@+id/Bar"
        android:layout_width="match_parent"
         android:layout_height="50dp"
          android:orientation="horizontal"
           android:background="#000000"
            android:alpha="0.7"
             android:layout_gravity="bottom"
              android:gravity="center"/> -->
        <!-- 下部のアクションバー風ボトムバー -->
        <!-- ガラスのカプセル(Compose で描く)の上にボタンを載せる -->
        <com.airsky.browser.GlassBottomBar
            android:id="@+id/bottomBar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:clickable="true"
            android:focusable="false"
            android:soundEffectsEnabled="false"
            android:layout_gravity="bottom">
        <LinearLayout
            android:id="@+id/bottomBarButtons"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="8dp"
            android:layout_marginVertical="4dp"
            android:paddingHorizontal="6dp"
            android:orientation="horizontal"
            android:background="@drawable/bg_glass_bar_clip"
            android:clipToOutline="true"
            android:gravity="center">
            <com.airsky.browser.ShadowImageButton
                android:id="@+id/backButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/nav_button_background"
                android:src="@drawable/ic_sysbar_back" />

            <ImageView
                android:id="@+id/backView"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:src="@drawable/ic_sysbar_lights_out_dot_large"
                android:visibility="gone"/>

            <com.airsky.browser.ShadowImageButton
                android:id="@+id/forwardButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/nav_button_background"
                android:src="@drawable/ic_sysbar_forward" />

            <ImageView
                android:id="@+id/forwardView"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:src="@drawable/ic_sysbar_lights_out_dot_large"
                android:visibility="gone"/>
            <!-- 再読み込みボタン -->
            <com.airsky.browser.ShadowImageButton
                android:id="@+id/action_reload"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:src="@drawable/reload"
                android:background="@drawable/nav_button_background"
                android:contentDescription="@string/i18n_72bdc2cc57" />
            <!--<ImageButton
            android:id="@+id/action_tab"
            android:layout_width="50dp"
            android:layout_height="match_parent"
            android:src="@drawable/tab_white"
            android:background="?android:attr/selectableItemBackground"
            android:contentDescription="タブ" />-->
            <FrameLayout
                android:id="@+id/tabCountButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/i18n_1eef06557b"
                android:clipChildren="false"
                android:foreground="@drawable/ripple_circle">
                <!-- 他のボタンと同じく、枠と数字の形に沿った影を付ける -->
                <com.airsky.browser.ShadowTextView
                    android:id="@+id/tabCountTextView"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:textStyle="bold"
                    android:duplicateParentState="true"
                    android:background="@drawable/bg_tab_count"
                    android:gravity="center"
                    android:text="0"
                    android:textColor="#ffffff"
                    android:textSize="13sp"/>
            </FrameLayout>
            <com.airsky.browser.ShadowImageButton
                android:id="@+id/action_popup"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:src="@mipmap/aozora"
                android:background="@drawable/nav_button_background"
                android:contentDescription="@string/i18n_9219fc8ca4" />
            <com.airsky.browser.ShadowImageButton
                android:layout_width="30dp"
                android:layout_height="match_parent"
                android:id="@+id/hidebottom"
                android:background="@drawable/nav_button_background"
                android:src="@drawable/hidebottom" />
        </LinearLayout>
        </com.airsky.browser.GlassBottomBar>


    <!-- ボトムバーを隠している間に出す「▲」。ページの上でも見えるよう、影付きの丸ボタンにする -->
    <ImageButton
        android:id="@+id/showbottom"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_show_bottom"
        android:elevation="6dp"
        android:contentDescription="@string/i18n_fd604ef92d"
        android:scaleType="center"
        android:src="@drawable/ic_show_bottom"
        android:tint="?attr/colorOnSurface"/>

        <!-- タブ一覧(Chrome 風)。表示中はブラウザ画面の上に重なる -->
        <include layout="@layout/tab_switcher" />

        <!-- 「タブを閉じました  元に戻す」の置き場。ボトムバーの上に合わせて上下する -->
        <androidx.coordinatorlayout.widget.CoordinatorLayout
            android:id="@+id/snackbarHost"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="false"
            android:focusable="false" />

        <ImageButton
            android:id="@+id/donttouch"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#00000000"/>

        <com.airsky.browser.TouchEffectView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="false"
            android:focusable="false"/>

    </FrameLayout>
    <!-- </FrameLayout> -->
</LinearLayout>