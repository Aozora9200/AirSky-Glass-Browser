<?xml version="1.0" encoding="utf-8"?>
<!-- タブ一覧の「タブグループ」の 1 行。ファビコンの 2 × 2・色の丸と名前・更新日時・メニュー -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tgRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="3dp"
    android:gravity="center_vertical"
    android:minHeight="116dp"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingTop="14dp"
    android:paddingEnd="4dp"
    android:paddingBottom="14dp">

    <GridLayout
        android:id="@+id/tgIcons"
        android:layout_width="92dp"
        android:layout_height="92dp"
        android:columnCount="2"
        android:padding="5dp"
        android:rowCount="2" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="18dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/tgDot"
                android:layout_width="14dp"
                android:layout_height="14dp" />

            <TextView
                android:id="@+id/tgTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:singleLine="true"
                android:textSize="18sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tgSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:singleLine="true"
            android:textSize="15sp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/tgMenu"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/i18n_238d7e9e6f"
        android:scaleType="center"
        android:src="@drawable/ic_ts_more" />
</LinearLayout>
