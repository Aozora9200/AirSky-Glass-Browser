<?xml version="1.0" encoding="utf-8"?>
<!-- タブ一覧の一番上の「非アクティブなタブ」(横いっぱいのカード。押すと非アクティブなタブの一覧を開く) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="6dp">

    <LinearLayout
        android:id="@+id/itCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="76dp"
        android:orientation="horizontal"
        android:paddingVertical="12dp"
        android:paddingStart="14dp"
        android:paddingEnd="10dp">

        <FrameLayout
            android:id="@+id/itIconBg"
            android:layout_width="44dp"
            android:layout_height="44dp">
            <ImageView
                android:id="@+id/itIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_ts_inactive" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/itTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:text="@string/i18n_670479bfcb"
                android:textSize="16sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/itSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- 中のタブのファビコン(重ねて並べる) -->
        <LinearLayout
            android:id="@+id/itIcons"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal" />

        <ImageView
            android:id="@+id/itChevron"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="6dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_ts_chevron_right" />
    </LinearLayout>
</FrameLayout>
