<?xml version="1.0" encoding="utf-8"?>
<!--
  Python 実行画面(PyRunActivity)。Pixel の設定風。
  上: 戻る・名前と状態・キー・停止 / コンソールと窓の切り替え / 中身(角の丸いカード) / キー / 入力欄
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ps_page_bg"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">
        <ImageButton
            android:id="@+id/pr_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/i18n_4a622f127b"
            android:src="@drawable/ic_si_back" />
        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_py_badge">
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_tool_python"
                app:tint="@color/ps_tone_blue_fg" />
        </FrameLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/pr_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="?attr/colorOnSurface"
                android:textSize="20sp" />
            <TextView
                android:id="@+id/pr_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="13sp" />
        </LinearLayout>
        <ImageButton
            android:id="@+id/pr_keys"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/i18n_332cd920e5"
            android:src="@drawable/ic_jr_keyboard"
            android:visibility="gone" />
        <ImageButton
            android:id="@+id/pr_stop"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/i18n_095e938e2a"
            android:src="@drawable/ic_jr_stop" />
    </LinearLayout>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/pr_progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:indeterminate="true"
        android:visibility="gone"
        app:trackCornerRadius="3dp"
        app:trackThickness="5dp" />

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/pr_tabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:visibility="gone"
        app:selectionRequired="true"
        app:singleSelection="true">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/pr_tab_console"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/i18n_617821f331" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/pr_tab_window"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/i18n_b116872cef" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/pr_console_scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_jr_card"
            android:clipToPadding="false"
            android:fillViewport="true">
            <TextView
                android:id="@+id/pr_console"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:lineSpacingMultiplier="1.15"
                android:padding="18dp"
                android:textColor="?attr/colorOnSurface"
                android:textIsSelectable="true"
                android:textSize="13sp" />
        </androidx.core.widget.NestedScrollView>

        <!-- Python の窓(PyGui が中に作る) -->
        <FrameLayout
            android:id="@+id/pr_window_area"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/pr_keypad"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        android:paddingTop="10dp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/pr_input_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">
        <EditText
            android:id="@+id/pr_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_jr_input"
            android:hint="@string/i18n_b16a6edf51"
            android:imeOptions="actionSend"
            android:importantForAutofill="no"
            android:inputType="text|textNoSuggestions"
            android:minHeight="56dp"
            android:paddingHorizontal="22dp"
            android:singleLine="true"
            android:textColor="?attr/colorOnSurface"
            android:textColorHint="?attr/colorOnSurfaceVariant"
            android:textSize="16sp" />
        <ImageButton
            android:id="@+id/pr_send"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_jr_send"
            android:contentDescription="@string/i18n_ad44d10e40"
            android:src="@drawable/ic_jr_send" />
    </LinearLayout>
</LinearLayout>
