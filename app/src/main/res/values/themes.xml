<resources xmlns:tools="http://schemas.android.com/tools">

    <!--  ===== Material 3 ベーステーマ（ライト/ダークは DayNight が自動で切り替え） =====  -->
    <style name="Theme.Aozora.Material" parent="Theme.Material3.DayNight">
        <item name="colorPrimary">@color/md_primary</item>
        <item name="colorOnPrimary">@color/md_on_primary</item>
        <item name="colorPrimaryContainer">@color/md_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/md_on_primary_container</item>
        <item name="colorSecondary">@color/md_secondary</item>
        <item name="colorOnSecondary">@color/md_on_secondary</item>
        <item name="colorSecondaryContainer">@color/md_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/md_on_secondary_container</item>
        <item name="colorTertiary">@color/md_tertiary</item>
        <item name="colorOnTertiary">@color/md_on_tertiary</item>
        <item name="colorTertiaryContainer">@color/md_tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/md_on_tertiary_container</item>
        <item name="colorError">@color/md_error</item>
        <item name="colorOnError">@color/md_on_error</item>
        <item name="colorErrorContainer">@color/md_error_container</item>
        <item name="colorOnErrorContainer">@color/md_on_error_container</item>
        <item name="android:colorBackground">@color/md_background</item>
        <item name="colorOnBackground">@color/md_on_background</item>
        <item name="colorSurface">@color/md_surface</item>
        <item name="colorOnSurface">@color/md_on_surface</item>
        <item name="colorSurfaceVariant">@color/md_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/md_on_surface_variant</item>
        <item name="colorSurfaceContainerLowest">@color/md_surface_container_lowest</item>
        <item name="colorSurfaceContainerLow">@color/md_surface_container_low</item>
        <item name="colorSurfaceContainer">@color/md_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/md_surface_container_high</item>
        <item name="colorSurfaceContainerHighest">@color/md_surface_container_highest</item>
        <item name="colorOutline">@color/md_outline</item>
        <item name="colorOutlineVariant">@color/md_outline_variant</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">@bool/md_light_bars</item>
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.Aozora.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.Aozora.Medium</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.Aozora.Large</item>
    </style>

    <style name="ShapeAppearance.Aozora.Small" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>
    <style name="ShapeAppearance.Aozora.Medium" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>
    <style name="ShapeAppearance.Aozora.Large" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>

    <!--  URL バー横のファビコンで開くサイト情報(画面の上から下りてくるパネル)  -->
    <style name="Theme.Aozora.SiteInfoPanel" parent="ThemeOverlay.Material3.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.32</item>
        <item name="android:windowMinWidthMajor">100%</item>
        <item name="android:windowMinWidthMinor">100%</item>
        <item name="android:windowAnimationStyle">@style/SiteInfoPanelAnimation</item>
    </style>

    <style name="SiteInfoPanelAnimation">
        <item name="android:windowEnterAnimation">@anim/site_info_panel_in</item>
        <item name="android:windowExitAnimation">@anim/site_info_panel_out</item>
    </style>

    <!--  ActionBar 付き（設定・一覧系）  -->
    <style name="Base.Theme.AozoraApp" parent="Theme.Aozora.Material">
        <item name="windowActionBar">true</item>
        <item name="windowNoTitle">false</item>
    </style>

    <!--  ActionBar なし（ツール系）  -->
    <style name="Base.Theme.AozoraTools" parent="Theme.Aozora.Material">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!--  ブラウザ本体（フルスクリーン）  -->
    <style name="Base.Theme.AozoraBrowser" parent="Base.Theme.AozoraTools">
        <item name="android:windowFullscreen">true</item>
    </style>
    <style name="Theme.AozoraBrowser" parent="Base.Theme.AozoraBrowser" />

    <style name="Theme.Aozora.Setup" parent="Base.Theme.AozoraTools">
        <item name="android:windowBackground">@color/setup_window_bg</item>
        <item name="android:colorBackground">@color/setup_window_bg</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="android:statusBarColor">@color/setup_window_bg</item>
    </style>

    <style name="Theme.Aozora.Battery" parent="Base.Theme.AozoraApp" />

    <style name="PopupAnimation">
        <item name="android:windowEnterAnimation">@anim/slide_in_up</item>
        <item name="android:windowExitAnimation">@anim/slide_out_down</item>
    </style>
</resources>
