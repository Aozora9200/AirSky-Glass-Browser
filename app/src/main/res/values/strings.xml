    <!-- Help: Saved Page -->
    <string name="help_savedpage_title">Save pages</string>
    <string name="help_savedpage_detail">Saving a page lets you view it offline. Tap the star button next to the URL bar to save the page. To save it as a file, use the page saving tool in the Tools list.</string>

    <!-- Help: Bookmark -->
    <string name="help_bookmark_title">Add bookmarks</string>
    <string name="help_bookmark_detail">To add a bookmark, save it with the star button next to the URL bar.</string>

    <!-- Help: Tools -->
    <string name="help_tools_title">Use tools</string>
    <string name="help_tools_detail">To start a tool, open the menu button (A) and tap Tools.</string>

    <!-- Help: Switch Tab -->
    <string name="help_switchtab_title">Switch tabs</string>
    <string name="help_switchtab_detail">To switch tabs, tap the tab button and choose the tab to switch to. You can close all tabs from the menu button in the tab list.</string>

    <!-- Boot Screen -->
    <string name="help_boot_title">Turn off the splash screen and startup sound</string>
    <string name="help_boot_detail">To turn off the splash screen and startup sound,\nuncheck \"Splash screen\" and \"Startup sound\" in the app settings section of the browser settings.</string>

    <!-- Settings -->
    <string name="help_settings_title">Open settings</string>
    <string name="help_settings_detail">Press the menu button (A), then press \"Settings\".\nYou can change various settings from the browser settings.</string>

    <!-- UA -->
    <string name="help_ua_title">What is a UA?</string>
    <string name="help_ua_detail">A UA (user agent) is information about your device that\'s passed to a website when you visit it.</string>

