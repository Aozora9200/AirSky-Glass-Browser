<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="shortcut_id_secret"
        android:icon="@drawable/ic_app_secret"
        android:shortcutShortLabel="@string/secretmode"
        android:shortcutLongLabel="@string/secretmode">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.airsky.browser"
            android:targetClass="com.airsky.browser.SecretActivity" />
